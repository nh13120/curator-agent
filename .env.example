# Copy to .env and fill in. Never paste these values into chat.

# Telegram bot created with @BotFather for Curator (new, separate bot).
CURATOR_TELEGRAM_BOT_TOKEN=
# Your own chat id with the bot (tools/telegram.py whoami prints it after you
# send the bot one message).
CURATOR_TELEGRAM_CHAT_ID=

# Google Calendar: desktop OAuth client. Download the client secret JSON from
# Google Cloud Console into config/google_client_secret.json (gitignored).
# The token file is created by `python3 tools/gcal.py auth`.
CURATOR_GOOGLE_CALENDAR_ID=primary

# Optional: enables Google Routes API for travel time instead of the estimate.
GOOGLE_MAPS_API_KEY=

# Optional: a Canvas deadline ledger (JSON: assignments -> {title, due_at, submitted}).
# Deadlines on the calendar ("... due", "deadline") are always used; this adds more.
CURATOR_DEADLINES_LEDGER=
