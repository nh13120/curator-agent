{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y", "@playwright/mcp@0.0.82",
        "--browser", "chrome",
        "--user-data-dir", "~/Library/Application Support/curator/chrome-profile",
        "--output-dir", "logs/screenshots"
      ]
    }
  }
}
