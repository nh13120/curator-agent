<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nicolash.curator.daily</string>
    <!-- Daily check, live mode. Credentials come from .env; nothing secret lives here. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT__/bin/run.sh</string>
        <string>daily</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT__</string>
    <!-- Every day 07:30 local time, after an optional deadline ledger is refreshed at 07:00. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>7</integer>
        <key>Minute</key><integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/curator.daily.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/curator.daily.launchd.err.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>
</dict>
</plist>
